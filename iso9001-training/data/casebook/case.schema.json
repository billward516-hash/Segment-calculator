{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data/casebook/case.schema.json",
  "title": "Sector Casebook case file (data/casebook/<pack>/<type>-<n>.json)",
  "description": "Schema from Appendix D.6.8 with the extensions the generator uses. The authoritative checks, including cross-references, run in CB.validateCase (games/casebook/engine.js) during the build and in tests/casebook-tests.js.",
  "type": "object",
  "required": ["id", "pack", "type", "title", "edition", "verifyStatus2015", "brief", "visitPoints", "goal", "branches", "hotspots", "evidence", "decisions", "expectedActions", "debriefText"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{3}-[A-F]-[0-9]{2}$", "description": "Sector code, case type, and number, for example MFG-B-01." },
    "pack": { "type": "string", "description": "Industry pack id from data/packs.json." },
    "type": { "enum": ["A", "B", "C", "D", "E", "F"] },
    "title": { "type": "string" },
    "edition": { "enum": ["2015", "2026"], "description": "2026 variants are excluded from badge scoring and the capstone until verified." },
    "verifyStatus2015": { "enum": ["unverified", "verified"] },
    "brief": { "type": "string" },
    "visitPoints": { "type": "integer", "minimum": 6, "maximum": 30 },
    "goal": { "type": "string" },
    "branches": { "type": "array", "items": { "enum": ["Evidence", "Mapping", "Cause", "Control", "Judgment"] }, "minItems": 1 },
    "tokens": {
      "type": "object",
      "description": "Optional fictional names and numbers. The seed picks one option set: each token uses option (set mod its length), so give related tokens the same number of options. Seed 0000 uses the first. Use {{token}} in any text.",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "referenceSelection": {
      "type": "object",
      "description": "Optional. The evidence shown for seed 0000, used for worked examples.",
      "properties": { "evidence": { "type": "array", "items": { "type": "string" } } }
    },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "actions"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["verb", "label"],
              "properties": {
                "verb": { "enum": ["Observe", "Ask", "Review"] },
                "label": { "type": "string" },
                "evidenceId": { "type": "string" },
                "note": { "type": "string", "description": "Shown instead of an evidence card when the action finds nothing of note." }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "kind", "text", "clause", "whyItMatters", "missedExplanation"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["nonconformity", "conforming", "observation", "redHerring"] },
          "text": { "type": "string" },
          "variants": { "type": "array", "items": { "type": "string" }, "description": "Alternative wordings with the same facts." },
          "clause": { "type": "string", "description": "One or more 2015 clause numbers from data/clause-map.json, separated by commas." },
          "unlockedBy": { "type": "array", "items": { "type": "string" }, "description": "The card appears after any one of these cards is collected." },
          "supports": { "type": "string", "description": "Id of the planted issue this card supports. Shown whenever that issue is planted." },
          "whyItMatters": { "type": "string" },
          "missedExplanation": { "type": "string" },
          "falseFindingNote": { "type": "string", "description": "Optional. Why this conforming card or red herring is conforming." },
          "plantedPool": { "type": "boolean", "description": "True for every planted issue (nonconformity or observation) the seed may select." }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt", "options", "bestIndex", "rationale"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
          "bestIndex": { "type": "integer", "minimum": 0 },
          "rationale": { "type": "string" },
          "optionFeedback": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "expectedActions": {
      "type": "object",
      "required": ["containment", "correction", "cause", "corrective", "effectiveness"],
      "properties": {
        "containment": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "correction": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "cause": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "corrective": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "effectiveness": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "actionDistractors": {
      "type": "object",
      "description": "Optional weak options per action element. When absent, the generic distractors in the engine are used."
    },
    "debriefText": {
      "type": "object",
      "required": ["found", "missed", "falseFinding"],
      "properties": { "found": { "type": "string" }, "missed": { "type": "string" }, "falseFinding": { "type": "string" } }
    }
  }
}
